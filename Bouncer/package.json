    "eslint": "^10.0.2",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "jsdom": "31.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "dompurify": "3.4.17"
  }
